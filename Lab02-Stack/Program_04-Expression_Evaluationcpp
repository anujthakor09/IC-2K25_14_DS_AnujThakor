#include <iostream>
#include <stack>
#include <string>
#include <cmath>
#include <algorithm>
using namespace std;

class ExpressionEvaluation {

    int calculate(int a, int b, char op) {
        switch (op) {
            case '+': return a + b;
            case '-': return a - b;
            case '*': return a * b;
            case '/': return a / b;
            case '^': return pow(a, b);
        }
        return 0;
    }

    bool isOperator(char ch) {
        return ch == '+' || ch == '-' || ch == '*' ||
               ch == '/' || ch == '^';
    }

public:

    // ---------------- POSTFIX ----------------
    int evaluatePostfix(string exp) {
        stack<int> st;

        for (int i = 0; i < exp.length(); i++) {
            char ch = exp[i];

            if (isdigit(ch)) {
                st.push(ch - '0');
            }
            else if (isOperator(ch)) {
                int b = st.top();
                st.pop();

                int a = st.top();
                st.pop();

                st.push(calculate(a, b, ch));
            }
        }

        return st.top();
    }


    // ---------------- PREFIX ----------------
    int evaluatePrefix(string exp) {
        stack<int> st;

        for (int i = exp.length() - 1; i >= 0; i--) {
            char ch = exp[i];

            if (isdigit(ch)) {
                st.push(ch - '0');
            }
            else if (isOperator(ch)) {
                int a = st.top();
                st.pop();

                int b = st.top();
                st.pop();

                st.push(calculate(a, b, ch));
            }
        }

        return st.top();
    }


    // ---------------- INFIX ----------------
    int evaluateInfix(string exp) {
        stack<int> values;
        stack<char> operators;

        for (int i = 0; i < exp.length(); i++) {
            char ch = exp[i];

            // Operand
            if (isdigit(ch)) {
                values.push(ch - '0');
            }

            // Opening bracket
            else if (ch == '(') {
                operators.push(ch);
            }

            // Closing bracket
            else if (ch == ')') {

                while (!operators.empty() && operators.top() != '(') {

                    int b = values.top();
                    values.pop();

                    int a = values.top();
                    values.pop();

                    char op = operators.top();
                    operators.pop();

                    values.push(calculate(a, b, op));
                }

                operators.pop();   // remove '('
            }

            // Operator
            else if (isOperator(ch)) {

                while (!operators.empty() &&
                       operators.top() != '(' &&
                       precedence(operators.top()) >= precedence(ch)) {

                    int b = values.top();
                    values.pop();

                    int a = values.top();
                    values.pop();

                    char op = operators.top();
                    operators.pop();

                    values.push(calculate(a, b, op));
                }

                operators.push(ch);
            }
        }

        // Remaining operators
        while (!operators.empty()) {

            int b = values.top();
            values.pop();

            int a = values.top();
            values.pop();

            char op = operators.top();
            operators.pop();

            values.push(calculate(a, b, op));
        }

        return values.top();
    }


    int precedence(char op) {
        if (op == '^')
            return 3;
        else if (op == '*' || op == '/')
            return 2;
        else if (op == '+' || op == '-')
            return 1;

        return 0;
    }
};


int main() {

    ExpressionEvaluation obj;

    string infix, prefix, postfix;

    cout << "Enter Infix expression: ";
    cin >> infix;

    cout << "Enter Prefix expression: ";
    cin >> prefix;

    cout << "Enter Postfix expression: ";
    cin >> postfix;

    cout << "\nResults:\n";

    cout << "Infix Result   = "
         << obj.evaluateInfix(infix) << endl;

    cout << "Prefix Result  = "
         << obj.evaluatePrefix(prefix) << endl;

    cout << "Postfix Result = "
         << obj.evaluatePostfix(postfix) << endl;

    return 0;
}
